importar {
    ServidorHttp,
    RespuestaHttp
} desde "quetzal/red"
importar {
    tipocambiort
} desde "./servicios/tipo_cambio/tipo_cambio.rt.qz"

ServidorHttp servidor = nuevo ServidorHttp()

servidor.estaticos("./publico")

// API para el tipo de cambio
servidor.usar("/api", tipocambiort.obtener_enrutador())

servidor.escuchar(5000)
consola.mostrar("Servidor corriendo en http://localhost:5000")


